# Set this to the HTTPS workers.dev origin for the local TETHER deployment.
TETHER_OAUTH_HANDOFF_URL=https://your-worker.your-account.workers.dev
# Optional. Defaults to ${TETHER_OAUTH_HANDOFF_URL}/oauth/callback.
# TETHER_OAUTH_REDIRECT_URL=https://your-worker.your-account.workers.dev/oauth/callback
